{
  "name": "zaisaku",
  "version": "0.1.0",
  "private": true,
  "description": "Zaisaku: a deterministic trading, auction and collecting game",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "vite build --config web/vite.config.ts --outDir ../dist",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "catalogue": "tsx src/tools/validate-catalogue.ts",
    "assets": "tsx src/tools/validate-assets.ts",
    "sim": "tsx src/sim/report.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "phaser": "3.87.0"
  }
}
